{
  "name": "painter-render",
  "version": "0.1.0",
  "private": true,
  "description": "Neo4j Visualization Library (NVL) front end for the painter crates.io graph",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,magenta \"node --watch server/index.mjs\" \"vite\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lod:build": "node server/lod/cli.mjs build",
    "lod:update": "node server/lod/cli.mjs update",
    "lod:status": "node server/lod/cli.mjs status"
  },
  "dependencies": {
    "express": "^5.1.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "neo4j-driver": "^6.0.0"
  },
  "devDependencies": {
    "@neo4j-nvl/base": "^2.0.0",
    "@neo4j-nvl/react": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
