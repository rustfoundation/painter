# Copy to .env and `set -a; . ./.env; set +a` (or use your own loader).
# All values shown are the defaults, which already match the compose neo4j
# service exposed on localhost.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j
NEO4J_MAX_ROWS=2000
NEO4J_QUERY_TIMEOUT_MS=30000
# 0 = retry forever while the database starts up
NEO4J_CONNECT_RETRIES=0
RENDER_ALLOW_CYPHER=true
PORT=8080
HOST=0.0.0.0

# Deps view
RENDER_DEPS_DEFAULT_EDGES=5000
RENDER_DEPS_MAX_EDGES=50000
RENDER_DEPS_TIMEOUT_MS=180000
RENDER_DEPS_CACHE_MS=600000

# Map view (level of detail). See README "Map precompute".
RENDER_LOD_ITERATIONS=300
RENDER_LOD_TIMEOUT_MS=3600000
RENDER_LOD_WORKER_HEAP_MB=8192
RENDER_LOD_BUDGET=600
RENDER_LOD_MAX_LEVEL=12
RENDER_LOD_CHECKPOINT=/tmp/painter-lod-checkpoint.json
