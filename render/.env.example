# Copy to .env and `set -a; . ./.env; set +a` (or use your own loader).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j
NEO4J_MAX_ROWS=2000
NEO4J_QUERY_TIMEOUT_MS=30000
# 0 = retry forever while the database starts up
NEO4J_CONNECT_RETRIES=0
RENDER_ALLOW_CYPHER=true
PORT=8080
HOST=0.0.0.0

RENDER_DEPS_DEFAULT_EDGES=5000
RENDER_DEPS_MAX_EDGES=50000
RENDER_DEPS_TIMEOUT_MS=180000
RENDER_DEPS_CACHE_MS=600000

RENDER_LOD_ITERATIONS=300
RENDER_LOD_TIMEOUT_MS=3600000
RENDER_LOD_WORKER_HEAP_MB=8192
RENDER_LOD_BUDGET=600
RENDER_LOD_MAX_LEVEL=12
RENDER_LOD_CHECKPOINT=/tmp/painter-lod-checkpoint.json

# Background jobs service (server/jobs/index.mjs, see README "Background jobs").
# render: forward stats refreshes and Map rebuilds there instead of running them itself.
#RENDER_JOBS_URL=http://127.0.0.1:8081
# jobs: dashboard totals (Stats nodes) refresh interval (0 = on request only), per-payload query timeout,
# and an optional timer for the cheap Map update (0 = off).
JOBS_STATS_INTERVAL_MS=900000
JOBS_QUERY_TIMEOUT_MS=600000
JOBS_LOD_UPDATE_INTERVAL_MS=0
